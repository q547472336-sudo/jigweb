# Local development only. The default OTP is 000000 when this value is omitted.
# x-user-id / x-guest-id are accepted only when all Supabase values below are empty.
LOCAL_OTP_CODE=000000

# Production/server-side persistence. Keep the service role key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
